{
  "name": "better-eh",
  "version": "1.0.7",
  "private": true,
  "description": "A userscript that reskins E-Hentai and ExHentai into one consistent, image-first interface: galleries, listings, favorites, toplists, torrents and the reader, with tag autocomplete and prefetching.",
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "update:tag-counts": "bun run scripts/update-tag-counts.ts",
    "update:tag-index": "bun run scripts/update-tag-index.ts",
    "update:core-vocabulary": "bun run scripts/update-core-vocabulary.ts",
    "check:generated": "bun run scripts/update-core-vocabulary.ts --check",
    "check:size": "bun run scripts/check-bundle-size.ts",
    "check:release-tag": "bun run scripts/check-release-tag.ts",
    "release": "bun run scripts/release.ts",
    "verify:release": "bun run scripts/verify-release.ts",
    "dev": "bun run build.ts --watch --serve",
    "typecheck": "./node_modules/.bin/bun check --no-script",
    "test": "bun test --isolate",
    "test:browser": "bun run test/browser/smoke.ts",
    "lint": "bun run scripts/lint.ts",
    "lint:fix": "bun run scripts/lint.ts --fix",
    "format": "./node_modules/.bin/bun fmt",
    "format:check": "./node_modules/.bin/bun fmt --check",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "prek": "prek run --all-files",
    "check:pr-version": "bun run scripts/check-pr-version.ts",
    "test:coverage": "bun run scripts/check-coverage.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/cli": "^4.3.5",
    "@types/bun": "latest",
    "@types/tampermonkey": "^5.5.0",
    "bun": "1.4.4-canary.20261024.1",
    "linkedom": "^0.18.15",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5"
  },
  "packageManager": "bun@1.4.4-canary.20261024.1"
}
