{
  "name": "better-eh",
  "version": "1.1.1",
  "private": true,
  "description": "A userscript that reskins E-Hentai and ExHentai into one consistent, image-first interface: galleries, listings, favorites, toplists, torrents and the reader, with tag autocomplete and prefetching.",
  "type": "module",
  "scripts": {
    "build": "./node_modules/.bin/bun run build.ts",
    "update:tag-counts": "./node_modules/.bin/bun run scripts/update-tag-counts.ts",
    "update:tag-index": "./node_modules/.bin/bun run scripts/update-tag-index.ts",
    "update:core-vocabulary": "./node_modules/.bin/bun run scripts/update-core-vocabulary.ts",
    "publish:tag-counts": "./node_modules/.bin/bun run scripts/publish-data.ts --branch automation/tag-popularity --message \"chore: update tag popularity data\"",
    "publish:tag-index": "./node_modules/.bin/bun run scripts/publish-data.ts --branch automation/tag-vocabulary --message \"chore: update tag vocabulary data\"",
    "check:generated": "./node_modules/.bin/bun run scripts/update-core-vocabulary.ts --check",
    "check:size": "./node_modules/.bin/bun run scripts/check-bundle-size.ts",
    "check:header": "./node_modules/.bin/bun run scripts/check-bundle-header.ts",
    "check:release-tag": "./node_modules/.bin/bun run scripts/check-release-tag.ts",
    "check:live": "./node_modules/.bin/bun run scripts/check-live-parsers.ts",
    "release": "./node_modules/.bin/bun run scripts/release.ts",
    "verify:release": "./node_modules/.bin/bun run scripts/verify-release.ts",
    "dev": "./node_modules/.bin/bun run build.ts --watch --serve",
    "typecheck": "./node_modules/.bin/bun check --no-script",
    "test": "./node_modules/.bin/bun test --isolate",
    "test:browser": "./node_modules/.bin/bun run test/browser/smoke.ts",
    "lint": "./node_modules/.bin/bun run scripts/lint.ts",
    "lint:fix": "./node_modules/.bin/bun run scripts/lint.ts --fix",
    "format": "./node_modules/.bin/bun fmt",
    "format:check": "./node_modules/.bin/bun fmt --check",
    "check": "./node_modules/.bin/bun run format:check && ./node_modules/.bin/bun run lint && ./node_modules/.bin/bun run typecheck",
    "prek": "prek run --all-files",
    "check:pr-version": "./node_modules/.bin/bun run scripts/check-pr-version.ts",
    "test:coverage": "./node_modules/.bin/bun run scripts/check-coverage.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@tailwindcss/cli": "^4.3.5",
    "@types/bun": "latest",
    "@types/tampermonkey": "^5.5.0",
    "bun": "1.4.5-canary.20261125.1",
    "linkedom": "^0.18.15",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5"
  },
  "packageManager": "bun@1.4.5-canary.20261125.1"
}
